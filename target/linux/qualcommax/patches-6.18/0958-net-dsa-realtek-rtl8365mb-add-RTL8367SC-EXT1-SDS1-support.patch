-#define pcs_to_rtl8365mb(_pcs) container_of((_pcs), struct rtl8365mb, pcs)
+#define pcs_to_serdes(_pcs) container_of((_pcs), struct rtl8365mb_serdes, pcs)
+#define pcs_to_rtl8365mb(_pcs) (pcs_to_serdes(_pcs)->mb)
+
+
+static struct rtl8365mb_serdes *
+rtl8365mb_get_serdes(struct rtl8365mb *mb, int port)
+{
+	if (port == mb->serdes.port)
+		return &mb->serdes;
+	if (mb->serdes1.port >= 0 && port == mb->serdes1.port)
+		return &mb->serdes1;
+	return NULL;
