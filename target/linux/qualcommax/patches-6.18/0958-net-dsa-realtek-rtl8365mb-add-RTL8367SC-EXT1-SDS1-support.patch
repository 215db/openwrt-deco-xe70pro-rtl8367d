 #define   RTL8365MB_D_FIBER_CFG2_RX_DISABLE_SDS0	BIT(6)
@@ -537,6 +538,9 @@
 #define   RTL8365MB_D_MAC4_SEL_EXT1_MASK			BIT(12)
 
 #define RTL8365MB_D_REG_SDS1_MISC0				0x1d78
+#define   RTL8365MB_D_SDS1_MISC0_PA33PC_EN		BIT(10)
+#define   RTL8365MB_D_SDS1_MISC0_PA12PC_EN		BIT(9)
+#define   RTL8365MB_D_SDS1_MISC0_MODE_FIELD_MASK	GENMASK(4, 0)
 
 /**
  * enum rtl8365mb_vlan_egress_mode - port VLAN egress mode
