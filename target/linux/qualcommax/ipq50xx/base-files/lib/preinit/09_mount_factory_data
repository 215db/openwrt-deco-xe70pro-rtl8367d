#!/bin/sh
# TP-Link boards keep their factory data (including the 6-byte
# "default-mac") in the factory_data UBIFS volume. Attach and mount it
# read-only during preinit so board.d/02_network and the ath11k caldata
# hotplug can read the MAC without each attaching the volume themselves.

. /lib/functions.sh

preinit_mount_factory_data() {
	case "$(board_name)" in
	tplink,deco-xe70pro|\
	tplink,eap650-outdoor-v1|\
	tplink,re700x) ;;
	*) return ;;
	esac

	# ubiattach lives in /usr/sbin, which the preinit PATH omits
	local PATH="/usr/sbin:/usr/bin:$PATH"
	local mtd_num ubi_num

	mtd_num=$(find_mtd_index factory_data)
	[ -n "$mtd_num" ] || return

	ubi_num=$(ubiattach -m "$mtd_num" 2>/dev/null | \
		sed -n 's/.*device number \([0-9]*\).*/\1/p')
	[ -n "$ubi_num" ] || return

	mkdir -p /tmp/factory_data
	mount -t ubifs -o ro,noatime "ubi${ubi_num}:ubi_factory_data" /tmp/factory_data 2>/dev/null
}

boot_hook_add preinit_main preinit_mount_factory_data
