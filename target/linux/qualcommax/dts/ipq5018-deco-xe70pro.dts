/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "TP-Link Deco XE70 Pro (v3)";
	compatible = "tplink,deco-xe70pro", "qcom,ipq5018-mp03.5-c1", "qcom,ipq5018";

	aliases {
		serial0 = &blsp1_uart1;
		label-mac-device = &gmac1;
		led-boot = &led_blue;
		led-failsafe = &led_red;
		led-running = &led_blue;
		led-upgrade = &led_red;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		/* Vendor labels this as WPS/Wi-Fi; GPL DTS uses KEY_WPS_BUTTON on GPIO 38. */
		button-wps {
			label = "wps";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		/*
		 * GPL (qcom-ipq5018-mp03.5-c1): single multi-color indicator with
		 * red=GPIO22, green=GPIO38, blue=GPIO13 (all active low).
		 * GPIO38 is also used by the WPS/Wi-Fi button in the vendor DTS, so
		 * the green channel is not exposed here to avoid a GPIO conflict.
		 */
		led_red: led-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
		};

		led_blue: led-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 13 GPIO_ACTIVE_LOW>;
		};
	};

};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x0 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "0:MIBIB";
				reg = <0x80000 0x80000>;
				read-only;
			};

			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x100000 0x40000>;
				read-only;
			};

			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x140000 0x40000>;
				read-only;
			};

			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x100000>;
				read-only;
			};

			partition@280000 {
				label = "0:DEVCFG";
				reg = <0x280000 0x40000>;
				read-only;
			};

			partition@2c0000 {
				label = "0:CDT";
				reg = <0x2c0000 0x40000>;
				read-only;
			};

			partition@300000 {
				label = "0:APPSBLENV";
				reg = <0x300000 0x80000>;
			};

			partition@380000 {
				label = "0:APPSBL";
				reg = <0x380000 0x140000>;
				read-only;
			};

			partition@4c0000 {
				label = "0:ART";
				reg = <0x4c0000 0x100000>;
				read-only;
			};

			partition@5c0000 {
				label = "0:TRAINING";
				reg = <0x5c0000 0x80000>;
				read-only;
			};

			partition@640000 {
				label = "rootfs";
				reg = <0x640000 0x2a00000>;
			};

			partition@3040000 {
				label = "rootfs_1";
				reg = <0x3040000 0x2a00000>;
			};

			partition@5a40000 {
				label = "0:ETHPHYFW";
				reg = <0x5a40000 0x80000>;
				read-only;
			};

			partition@5ac0000 {
				label = "factory_data";
				reg = <0x5ac0000 0x900000>;
				read-only;
			};

			partition@63c0000 {
				label = "runtime_data";
				reg = <0x63c0000 0x1100000>;
				read-only;
			};
		};
	};
};



&mdio0 {
	status = "okay";
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_50MHZ>;
};

&gmac1 {
	status = "okay";

	phy-mode = "2500base-x";

	fixed-link {
		speed = <2500>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";


	switch@1d {
		compatible = "realtek,rtl8365mb";
		reg = <0x1d>;
		reset-gpios = <&tlmm 33 GPIO_ACTIVE_LOW>;


		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;

			switchphy0: ethernet-phy@0 {
				reg = <0>;
			};

			switchphy1: ethernet-phy@1 {
				reg = <1>;
			};

		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "lan1";
				phy-handle = <&switchphy0>;
			};

			port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&switchphy1>;
			};

			/* EXT_PORT0 = hardware port 6 = CPU uplink to IPQ5018  */
			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac1>;
				phy-mode = "2500base-x";

				fixed-link {
					speed = <2500>;
					full-duplex;
				};
			};
			
			/* EXT_PORT1 = hardware port 7 = WAN via RTL8221B */
			port@7 {
				reg = <7>;
				label = "wan";
				phy-mode = "2500base-x";
				phy-handle = <&wan_phy>;
			};
			
		}; /* End ports */
	}; /* End switch0@1d */
	
	/* The External WAN PHY - Now a sibling, not a child */
	wan_phy: ethernet-phy@6 {
		reg = <6>;
		compatible = "ethernet-phy-ieee802.3-c45"; 	// was compatible = "ethernet-phy-id001c.c849";
		reset-gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
		reset-assert-us = <100000>;
		reset-deassert-us = <20000>;

	};
	
}; /* End mdio1 */

/*
 * WiFi (GPL qcom-ipq5018-mp03.5-c1, ap-mp03.5*): tri-band
 *   - IPQ5018 2.4 GHz (q6_wcss_pd1)
 *   - QCN6122 5 GHz   (q6_wcss_pd2 / wifi1@b00a040)
 *   - QCN6122 6 GHz   (q6_wcss_pd3 / wifi2@b00b040)
 * Pre-cal data in 0:ART at 0x1000/0x26800/0x4c000 (see caldata hotplug).
 * Calibration variants/BDFs are board-specific and TBD.
 */
&q6_region {
	reg = <0x0 0x4b000000 0x0 0x4d00000>;
};

&q6v5_wcss {
	status = "okay";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
	qcom,calibration-variant = "TP-Link-Deco-XE70-Pro";
};

&wifi1 {
	/* Swap test: b00a040/pd2 as 6 GHz candidate (native cal 0x26800) */
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
	qcom,calibration-variant = "TP-Link-Deco-XE70-Pro-6G";
};

&wifi2 {
	/* Swap test: b00b040/pd3 as 5 GHz (native cal 0x4C000) - strong 5G scans observed */
	status = "okay";

	qcom,rproc = <&q6_wcss_pd3>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd3";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4e500000>;
	qcom,m3-dump-addr = <0x4f200000>;
	qcom,calibration-variant = "TP-Link-Deco-XE70-Pro-5G";
};

&tlmm {
	button_pins: button-state {
		pins = "gpio12", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdio1_pins: mdio1-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};
